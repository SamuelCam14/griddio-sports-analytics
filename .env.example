# ============================================================
#  SPORTS ANALYTICS PLATFORM — Variables de Entorno
#  Copia este archivo como .env y rellena los valores
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=sports_user
POSTGRES_PASSWORD=sports_pass_dev
POSTGRES_DB=sports_analytics
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sports_user:sports_pass_dev@db:5432/sports_analytics

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- FastAPI ---
APP_ENV=development
SECRET_KEY=changeme_super_secret_key_32chars_min
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- The Odds API (https://the-odds-api.com — plan gratuito: 500 req/mes) ---
ODDS_API_KEY=YOUR_ODDS_API_KEY_HERE
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# --- NBA API (nba_api — gratuita, no requiere key) ---
NBA_API_SLEEP_SECONDS=0.7

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- ML ---
MODEL_VERSION=v1
MODELS_DIR=/app/ml/models
